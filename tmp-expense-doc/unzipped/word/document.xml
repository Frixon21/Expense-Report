fice/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p w14:paraId="19E2D896" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRPr="002D4DF2" w:rsidRDefault="002D4DF2" w:rsidP="002D4DF2"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:before="105" w:after="105" w:line="360" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Georgia" w:eastAsia="Aptos" w:hAnsi="Aptos" w:cs="Times New Roman"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r w:rsidRPr="002D4DF2"><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:color w:val="000000"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr><w:t>The employee must submit a completed expense report through [expense system / accounting workflow / designated form].</w:t></w:r></w:p><w:p w14:paraId="2E9BBFBF" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRPr="002D4DF2" w:rsidRDefault="002D4DF2" w:rsidP="002D4DF2"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:before="105" w:after="105" w:line="360" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Georgia" w:eastAsia="Aptos" w:hAnsi="Aptos" w:cs="Times New Roman"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r w:rsidRPr="002D4DF2"><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:color w:val="000000"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr><w:t>The report must identify the expense category, amount, date, business purpose, client/project/cost center if applicable, and required supporting records.</w:t></w:r></w:p><w:p w14:paraId="2817C047" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRPr="002D4DF2" w:rsidRDefault="002D4DF2" w:rsidP="002D4DF2"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:before="105" w:after="105" w:line="360" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Georgia" w:eastAsia="Aptos" w:hAnsi="Aptos" w:cs="Times New Roman"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r w:rsidRPr="002D4DF2"><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:color w:val="000000"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr><w:t>The employee’s manager or designated approver must review the business purpose and compliance with Company policy.</w:t></w:r></w:p><w:p w14:paraId="32383EFB" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRPr="002D4DF2" w:rsidRDefault="002D4DF2" w:rsidP="002D4DF2"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:before="105" w:after="105" w:line="360" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Georgia" w:eastAsia="Aptos" w:hAnsi="Aptos" w:cs="Times New Roman"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r w:rsidRPr="002D4DF2"><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:color w:val="000000"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr><w:t>[Finance / Controller / Accounts Payable] will review documentation, determine the reimbursable amount, and issue payment under normal payment procedures.</w:t></w:r></w:p><w:p w14:paraId="32D4FF32" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRPr="002D4DF2" w:rsidRDefault="002D4DF2" w:rsidP="002D4DF2"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:before="105" w:after="210" w:line="360" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Georgia" w:eastAsia="Aptos" w:hAnsi="Aptos" w:cs="Times New Roman"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r w:rsidRPr="002D4DF2"><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:color w:val="000000"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr><w:t xml:space="preserve">No employee may approve their own reimbursement. Biztech may require original receipts, legible electronic copies, card statements, invoices, mileage records, conference agendas, travel itineraries, client documentation, or other reasonable evidence. Electronic records are acceptable if they are complete, legible, reliable, and retained. </w:t></w:r></w:p><w:p w14:paraId="5273FA2B" w14:textId="3C83899B" w:rsidR="00C056D1" w:rsidRDefault="002D4DF2"><w:pPr><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:b/><w:color w:val="000000"/><w:kern w:val="0"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r w:rsidRPr="002D4DF2"><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:b/><w:color w:val="000000"/><w:kern w:val="0"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr><w:t>Eligible Expense Categories</w:t></w:r></w:p><w:p w14:paraId="4060D1FF" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRPr="002D4DF2" w:rsidRDefault="002D4DF2" w:rsidP="002D4DF2"><w:pPr><w:spacing w:after="210" w:line="360" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Georgia" w:eastAsia="Aptos" w:hAnsi="Aptos" w:cs="Times New Roman"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r w:rsidRPr="002D4DF2"><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:color w:val="000000"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr><w:t>Eligible travel may include reasonable business transportation, lodging, baggage/shipping, parking, tolls, business communications, business internet access, and other ordinary and necessary travel costs which are beyond the normal expectations of daily living.</w:t></w:r></w:p><w:p w14:paraId="5D65032B" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRPr="002D4DF2" w:rsidRDefault="002D4DF2" w:rsidP="002D4DF2"><w:pPr><w:spacing w:after="210" w:line="360" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Georgia" w:eastAsia="Aptos" w:hAnsi="Aptos" w:cs="Times New Roman"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r w:rsidRPr="002D4DF2"><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:color w:val="000000"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr><w:t>Travel must have a bona fide Company business purpose. Personal travel days, upgrades for personal preference, spouse/dependent travel without a bona fide business purpose, and personal side trips are not reimbursable.</w:t></w:r></w:p><w:p w14:paraId="0737792B" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRPr="002D4DF2" w:rsidRDefault="002D4DF2" w:rsidP="002D4DF2"><w:pPr><w:spacing w:after="210" w:line="360" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Georgia" w:eastAsia="Aptos" w:hAnsi="Aptos" w:cs="Times New Roman"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r w:rsidRPr="002D4DF2"><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:color w:val="000000"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr><w:t>For travel expenses, the employee must document the destination, dates, business purpose, and any personal component. Biztech will reimburse only the business portion of mixed business/personal travel.</w:t></w:r></w:p><w:p w14:paraId="7630135A" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRPr="002D4DF2" w:rsidRDefault="002D4DF2" w:rsidP="002D4DF2"><w:pPr><w:spacing w:before="315" w:after="105" w:line="360" w:lineRule="auto"/><w:ind w:left="-30"/><w:rPr><w:rFonts w:ascii="Georgia" w:eastAsia="Aptos" w:hAnsi="Aptos" w:cs="Times New Roman"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:bookmarkStart w:id="0" w:name="b_meals"/><w:r w:rsidRPr="002D4DF2"><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:b/><w:color w:val="000000"/><w:kern w:val="0"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr><w:t>B. Meals</w:t></w:r><w:bookmarkEnd w:id="0"/></w:p><w:p w14:paraId="2D634E65" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRPr="002D4DF2" w:rsidRDefault="002D4DF2" w:rsidP="002D4DF2"><w:pPr><w:spacing w:after="210" w:line="360" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Georgia" w:eastAsia="Aptos" w:hAnsi="Aptos" w:cs="Times New Roman"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r w:rsidRPr="002D4DF2"><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:color w:val="000000"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr><w:t>Business meals may be reimbursed when they are ordinary, necessary, reasonable, properly documented, and allowed under the Plan policy. The employee must provide the amount, date, location, business purpose, and the names and business relationships of attendees when applicable.</w:t></w:r></w:p><w:p w14:paraId="55C34558" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRPr="002D4DF2" w:rsidRDefault="002D4DF2" w:rsidP="002D4DF2"><w:pPr><w:spacing w:after="210" w:line="360" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Georgia" w:eastAsia="Aptos" w:hAnsi="Aptos" w:cs="Times New Roman"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r w:rsidRPr="002D4DF2"><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:color w:val="000000"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr><w:t>Local meals, meals of convenience, personal meals, and lavish or extravagant expenses are not reimbursable.</w:t></w:r></w:p><w:p w14:paraId="3F4813D7" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRPr="002D4DF2" w:rsidRDefault="002D4DF2" w:rsidP="002D4DF2"><w:pPr><w:spacing w:before="315" w:after="105" w:line="360" w:lineRule="auto"/><w:ind w:left="-30"/><w:rPr><w:rFonts w:ascii="Georgia" w:eastAsia="Aptos" w:hAnsi="Aptos" w:cs="Times New Roman"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:bookmarkStart w:id="1" w:name="c_personal_vehicle_business_use"/><w:r w:rsidRPr="002D4DF2"><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:b/><w:color w:val="000000"/><w:kern w:val="0"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr><w:t>C. Personal vehicle business use</w:t></w:r><w:bookmarkEnd w:id="1"/></w:p><w:p w14:paraId="4B2DF4E6" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRPr="002D4DF2" w:rsidRDefault="002D4DF2" w:rsidP="002D4DF2"><w:pPr><w:spacing w:after="210" w:line="360" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Georgia" w:eastAsia="Aptos" w:hAnsi="Aptos" w:cs="Times New Roman"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r w:rsidRPr="002D4DF2"><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:color w:val="000000"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr><w:lastRenderedPageBreak/><w:t>Biztech may reimburse an employee for approved business use of the employee’s personally owned or leased vehicle using:</w:t></w:r></w:p><w:p w14:paraId="3D18F492" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRPr="002D4DF2" w:rsidRDefault="002D4DF2" w:rsidP="002D4DF2"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:before="105" w:after="105" w:line="360" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Georgia" w:eastAsia="Aptos" w:hAnsi="Aptos" w:cs="Times New Roman"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r w:rsidRPr="002D4DF2"><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:color w:val="000000"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr><w:t>The IRS standard mileage rate in effect for the applicable period</w:t></w:r></w:p><w:p w14:paraId="5D1EB0D6" w14:textId="52BDB40E" w:rsidR="002D4DF2" w:rsidRDefault="002D4DF2"><w:pPr><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:color w:val="000000"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r w:rsidRPr="002D4DF2"><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:color w:val="000000"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr><w:t>Traffic tickets, parking violations, vehicle repairs from negligence, and other personal vehicle costs are not reimbursable.</w:t></w:r></w:p><w:p w14:paraId="745336C3" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRDefault="002D4DF2"><w:pPr><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:color w:val="000000"/><w:kern w:val="0"/><w:sz w:val="21"/><w:szCs w:val="22"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4896E101" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRDefault="002D4DF2" w:rsidP="002D4DF2"><w:pPr><w:spacing w:after="210" w:line="360" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="source serif 4" w:eastAsia="source serif 4" w:hAnsi="source serif 4" w:cs="source serif 4"/><w:color w:val="000000"/></w:rPr><w:t>Biztech may reimburse client-related, project-related, marketing, shipping, communication, and other ordinary and necessary business expenses that are preapproved where required and properly substantiated.</w:t></w:r></w:p><w:p w14:paraId="4BF793C7" w14:textId="77777777" w:rsidR="002D4DF2" w:rsidRDefault="002D4DF2"/><w:sectPr w:rsidR="002D4DF2"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="720" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>