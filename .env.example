# Expense Report uses its own server-side session after BT Auth verifies the identity.
# Set a random value of at least 32 bytes for a persistent deployment session key.
AUTH_SESSION_SECRET=
APP_PUBLIC_ORIGIN=http://127.0.0.1:3000
AUTH_TRUST_PROXY=false
EXPENSE_REPORT_DB_PATH=.data/expense-report.sqlite

# Keep the auth and JWKS URLs on a protected HTTPS route. Set the issuer to the
# exact SERVICE_ISSUER configured by BT Auth; its RS256 session tokens omit aud.
# BT_AUTH_BASE_URL=
# BT_AUTH_JWKS_URL=
# BT_AUTH_ISSUER=
BT_AUTH_COOKIE_NAME=bt_session
BT_AUTH_USERNAME_FIELD=username
BT_AUTH_PASSWORD_FIELD=password
# HTTP sends the login password and returned BT Auth token without encryption.
# Keep false except for local development or an explicitly accepted office LAN.
BT_AUTH_ALLOW_HTTP=false

# Enable only for the one-time first-admin bootstrap, then remove it.
# FIRST_ADMIN_BOOTSTRAP_TOKEN=
