# Expense Report uses its own server-side session after BT Auth verifies the identity.
# Set a random value of at least 32 bytes for a persistent deployment session key.
AUTH_SESSION_SECRET=
APP_PUBLIC_ORIGIN=http://127.0.0.1:3000
EXPENSE_REPORT_DB_PATH=.data/expense-report.sqlite

# Existing external BTAuth HTTP endpoints; kept for the TrueNAS deployment.
# Set the issuer to the exact, unchanged BT Auth SERVICE_ISSUER identifier.
# Its RS256 session tokens omit aud. The issuer need not match the HTTP hostname.
BT_AUTH_BASE_URL=http://192.168.203.238:3210
BT_AUTH_JWKS_URL=http://192.168.203.238:3210/.well-known/jwks.json
BT_AUTH_ISSUER=http://auth.biztechro.com
BT_AUTH_COOKIE_NAME=bt_session
BT_AUTH_USERNAME_FIELD=username
BT_AUTH_PASSWORD_FIELD=password
# HTTP is supported in production without an opt-in flag. Keep this deployment
# within the approved internal network; credentials and sessions are unencrypted.

# Enable only for the one-time first-admin bootstrap, then remove it.
# FIRST_ADMIN_BOOTSTRAP_TOKEN=

# Resend server secrets only; external delivery remains disabled until approved.
# RESEND_API_KEY= (supply via an approved runtime secret mechanism)
RESEND_DELIVERY_ENABLED=false

# Optional explicit issuer continuity: configure BOTH only after verifying each subject.
# BT_AUTH_LEGACY_ISSUER=http://auth.biztechro.com
# BT_AUTH_LEGACY_SUBJECTS=["confirmed-subject-id"]

# Alternative to LEGACY_SUBJECTS: explicit trust in the complete migrated subject namespace.
# BT_AUTH_LEGACY_REALM_CONFIRMED=true
# Never configure REALM_CONFIRMED together with LEGACY_SUBJECTS.
